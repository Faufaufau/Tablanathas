{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tablanathas",
  "main": "../backend/src/worker.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "nodejs_als"],
  "workers_dev": true,
  "upload_source_maps": true,
  "limits": {
    "cpu_ms": 30000
  },
  "assets": {
    "directory": "../frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*"]
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "REPLACE_WITH_HYPERDRIVE_ID"
    }
  ],
  "ratelimits": [
    {
      "name": "LOGIN_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "vars": {
    "WEB_ORIGIN": "https://REPLACE_WITH_YOUR_DOMAIN",
    "ANATHAS_API_BASE_URL": "https://www.anathas.com/api/v2",
    "ANATHAS_TIMEZONE": "Europe/Paris",
    "ANATHAS_SNAPSHOT_POLL_MS": "30000",
    "ANATHAS_DEFAULT_AGRICULTURAL_ZONES": "0",
    "ANATHAS_DEFAULT_HABITABLE_ZONES": "0"
  }
}
