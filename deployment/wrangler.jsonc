{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tablanathas",
  "main": "../backend/src/worker.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "nodejs_als"],
  "workers_dev": true,
  "upload_source_maps": true,
  "assets": {
    "directory": "../frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*"]
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "741b07852e10454fb9c9c028b72ebc93"
    }
  ],
  "ratelimits": [
    {
      "name": "LOGIN_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "triggers": {
    "crons": ["* * * * *"]
  },
  "vars": {
    "WEB_ORIGIN": "https://tablanathas.flosnihil.workers.dev",
    "ANATHAS_API_BASE_URL": "https://www.anathas.com/api/v2",
    "ANATHAS_TIMEZONE": "Europe/Paris",
    "ANATHAS_SNAPSHOT_POLL_MS": "30000",
    "ANATHAS_DEFAULT_AGRICULTURAL_ZONES": "0",
    "ANATHAS_DEFAULT_HABITABLE_ZONES": "0",
    "PASSWORD_SERVICE_URL": "https://br-jolly-snow-b95dnsan-password.compute.c-7.eu-central-1.aws.neon.tech"
  }
}
