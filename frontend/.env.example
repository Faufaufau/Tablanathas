# Développement local uniquement : l'API Express écoute par défaut sur le port 3000.
VITE_API_URL=http://localhost:3000

# En production, ne copie pas cette valeur :
# - laisse VITE_API_URL vide pour appeler /api sur la même origine (reverse proxy),
# - ou définis une origine publique telle que https://api.example.com AVANT npm run build.
