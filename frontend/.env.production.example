# Production avec frontend et backend sous le même domaine :
# les appels seront relatifs (/api) et le reverse proxy transmettra /api à Express.
VITE_API_URL=

# Si l'API est hébergée sur une origine distincte, indique son ORIGINE (sans /api),
# puis adapte WEB_ORIGIN côté backend avant de construire :
# VITE_API_URL=https://api.example.com
