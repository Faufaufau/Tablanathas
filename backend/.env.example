PORT=3000
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/Tablanathas
NODE_ENV=development
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters-long
WEB_ORIGIN=http://localhost:5173 # développement local uniquement

# API Anathas : la clé reste dans le backend, jamais dans le frontend.
ANATHAS_API_KEY=remplacer_par_votre_cle_api
ANATHAS_API_BASE_URL=https://www.anathas.com/api/v2

# Captures Anathas en heure locale Europe/Paris : 05:05, 18:00, 20:05, 00:00.
ANATHAS_TIMEZONE=Europe/Paris
ANATHAS_SNAPSHOT_POLL_MS=30000
# Valeur temporaire explicitement configurable : cette donnée n'existe pas dans l'API.
ANATHAS_DEFAULT_AGRICULTURAL_ZONES=0
# Champ absent de l'API ; valeur de repli pour les joueurs sans historique local.
ANATHAS_DEFAULT_HABITABLE_ZONES=0
# Facultatif : par défaut, le backend utilise le premier jeu de la table games.
# ANATHAS_GAME_ID=1
