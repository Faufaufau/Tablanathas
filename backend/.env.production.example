# Exemple de variables pour le serveur de production.
# Ce fichier est un modèle : Node/dotenv charge .env, pas .env.production.example.
# Configure les variables dans le gestionnaire de services/hébergeur, ou copie ce fichier
# vers backend/.env sur le serveur en gardant ce fichier secret et hors de Git.
NODE_ENV=production
PORT=3000
DATABASE_URL=postgresql://tablanathas:REMPLACER_MOT_DE_PASSE@127.0.0.1:5432/Tablanathas
SESSION_SECRET=REMPLACER_PAR_UN_SECRET_ALEATOIRE_D_AU_MOINS_32_CARACTERES
WEB_ORIGIN=https://app.example.com

# La clé API reste exclusivement dans le backend.
ANATHAS_API_KEY=REMPLACER_PAR_VOTRE_CLE_API
ANATHAS_API_BASE_URL=https://www.anathas.com/api/v2
ANATHAS_TIMEZONE=Europe/Paris
ANATHAS_SNAPSHOT_POLL_MS=30000
ANATHAS_DEFAULT_AGRICULTURAL_ZONES=0
ANATHAS_DEFAULT_HABITABLE_ZONES=0
# ANATHAS_GAME_ID=1
